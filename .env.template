# install mode: local (just run the app) | dev (edit the code, live reload) | prod (deployment)
MODE=local

# absolute path of the folder storing all app data on the host machine (media files, api data). Created if missing. Defaults to <project>/data
DATA_DIR=

# ------------------------------- ports --------------------------------------

# port the Django app runs on
DJANGO_PORT=8001
# database port
DB_PORT=5432
# must be same as $API_PORT in .env.dev (only used for dev)
API_PORT=5001
# Redis port
REDIS_PORT=6379
# Port for SMTP (25 for unencrypted, 587 for TLS, 465 for SSL)
EMAIL_PORT=25
# Dockerized nginx entrypoint
NGINX_PORT=8080

# --------------------- credentials (blank = auto-generated) -----------------

# database name
POSTGRES_DB=demowebsite
# database user (also used as django admin user)
POSTGRES_USER=demowebsite
#  also used as django admin password (with admin username)  
POSTGRES_PASSWORD=
SECRET_KEY=

# ------------------------------ prod only -----------------------------------

# full URL of the deployed API (e.g. https://discover-api.enpc.fr)
PROD_API_URL=
# domain name of the deployed front, without scheme (e.g. aikon.enpc.fr)
PROD_URL=
# SMTP server domain. to use your own SMTP server, or an institutional SMTP server, see: https://github.com/Aikon-platform/aikon/wiki/Email-Setup#smtp-server-setup-institutional-smtp-server
EMAIL_HOST=smtp.gmail.com
# use TLS encryption. set to False if using an institutional email and not gmail
EMAIL_USE_TLS=True
# username to log in to your SMTP server. might need to keep blank if using an institutional email
EMAIL_HOST_USER=
# password to log in to your SMTP server. might need to keep blank if using an institutional email
EMAIL_HOST_PASSWORD=
# email address to send alert emails to users
DEFAULT_FROM_EMAIL=noreply@mail.com
# site administrator email address where the app will send mails in case of errors
ADMIN_EMAIL=your-address@mail.com
# List of allowed host separated by a comma
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,nginx,host.docker.internal,
HTTP_PROXY=
HTTPS_PROXY=

# ----------------------- advanced -----------------------

NGINX_MAX_BODY_SIZE=500M
NGINX_TIMEOUT=300
